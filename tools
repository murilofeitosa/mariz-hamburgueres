w("burger-mignon.svg", Art.burger(["mignon","vinagrete","cheddar","queijo"], { label: "X-Filé Mignon" }));
w("burger-classico.svg", Art.burger(["burger","queijo"], { label: "X-Burguer" }));
w("fries.svg", Art.fries());

