
/* Gera as imagens estáticas em assets/img/ (rodar: node tools/build-images.js) */
const fs = require("fs");
const path = require("path");
const Art = require("../js/burger-art.js");
const out = path.join(__dirname, "..", "assets", "img");
fs.mkdirSync(out, { recursive: true });
const w = (n, c) => fs.writeFileSync(path.join(out, n), c);

// Hambúrgueres de destaque
w("burger-xtudo.svg", Art.burger(["burger","presunto","queijo","ovo","bacon","salada","tomate"], { label: "X-Tudo" }));
